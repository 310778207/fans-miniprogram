.addr {
  position: relative;
}

.addr-current {
  border: 2rpx solid #b9432f;
}

.addr-top {
  display: flex;
  align-items: center;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.addr-phone {
  font-size: 26rpx;
  color: #6b655b;
}

.addr-default {
  margin-left: auto;
  font-size: 20rpx;
  color: #b9432f;
  border: 1rpx solid rgba(185, 67, 47, 0.5);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.addr-detail {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #5c544a;
  padding-right: 80rpx;
}

.addr-edit {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #8a857c;
  padding: 6rpx;
}

.addr-add-wrap {
  margin-top: 40rpx;
}

.addr-add {
  width: 100%;
}

.addr-tip {
  text-align: center;
  font-size: 22rpx;
  color: #b8b2a8;
  margin-top: 16rpx;
}
