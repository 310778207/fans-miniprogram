<view class="page">
  <view class="card">
    <view class="field">
      <text class="field-label">收货人 <text class="req">*</text></text>
      <input class="field-input" placeholder="姓名" value="{{form.name}}" bindinput="onField" data-field="name" />
    </view>
    <view class="field">
      <text class="field-label">手机号 <text class="req">*</text></text>
      <input class="field-input" type="number" maxlength="11" placeholder="11 位手机号" value="{{form.phone}}" bindinput="onField" data-field="phone" />
    </view>
    <view class="field">
      <text class="field-label">所在地区 <text class="req">*</text></text>
      <picker mode="region" bindchange="onRegion">
        <view class="field-input {{form.region ? '' : 'placeholder'}}">{{form.region || '选择省 / 市 / 区'}}</view>
      </picker>
    </view>
    <view class="field field-area">
      <text class="field-label">详细地址 <text class="req">*</text></text>
      <textarea class="field-textarea" placeholder="街道、门牌号、楼栋房间号等" value="{{form.detail}}" maxlength="120" bindinput="onField" data-field="detail" />
    </view>
    <view class="field">
      <text class="field-label">设为默认</text>
      <switch checked="{{form.isDefault}}" color="#B9432F" bindchange="onDefaultChange" />
    </view>
  </view>

  <button class="btn-primary save-btn" hover-class="hover" bindtap="onSave">保存</button>
  <button class="btn-plain del-btn" wx:if="{{form.id}}" hover-class="hover" bindtap="onDelete">删除该地址</button>
</view>
