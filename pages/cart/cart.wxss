page {
  background: #f7f4ef;
}

.cart {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.cart-list {
  padding: 24rpx;
}

.c-item {
  position: relative;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(80, 60, 40, 0.05);
}

/* 自绘勾选框 */
.ck {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #d5cec2;
  margin-right: 16rpx;
  flex-shrink: 0;
  position: relative;
}

.ck-on {
  background: #b9432f;
  border-color: #b9432f;
}

.ck-on::after {
  content: '✓';
  color: #fff;
  font-size: 24rpx;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -52%);
}

.c-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f3ead9;
  flex-shrink: 0;
}

.c-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.c-name {
  font-size: 26rpx;
  color: #33302b;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.c-color {
  display: inline-block;
  font-size: 20rpx;
  color: #8e5b3c;
  background: rgba(201, 160, 99, 0.14);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-top: 8rpx;
}

.c-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.stepper {
  display: inline-flex;
  align-items: center;
  border: 2rpx solid #e5ddcf;
  border-radius: 8rpx;
  overflow: hidden;
}

.step-btn {
  width: 52rpx;
  height: 48rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5c544a;
  background: #f4efe7;
}

.step-input {
  width: 72rpx;
  height: 48rpx;
  min-height: 48rpx;
  text-align: center;
  font-size: 26rpx;
}

.c-del {
  position: absolute;
  right: 20rpx;
  top: 16rpx;
  color: #c9c2b6;
  font-size: 28rpx;
  padding: 6rpx;
}

/* 底部结算栏 */
.settle-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(80, 60, 40, 0.08);
}

.ck.settle-ck {
  margin-right: 8rpx;
}

.all-label {
  font-size: 24rpx;
  color: #5c544a;
  margin-right: 10rpx;
}

.settle-total {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #5c544a;
  margin-right: 20rpx;
}

.settle-price {
  font-size: 34rpx;
}

.settle-btn {
  background: #b9432f;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
}

.settle-disabled {
  background: #d8b0a6;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 220rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.4;
}

.empty-text {
  margin: 24rpx 0 40rpx;
  color: #8a857c;
  font-size: 28rpx;
}

.empty-btn {
  padding: 14rpx 70rpx;
}
