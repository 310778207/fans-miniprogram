page {
  background: #f7f4ef;
}

.detail {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.gallery {
  position: relative;
}

.gallery-swiper {
  height: 750rpx;
}

.gallery-img {
  width: 750rpx;
  height: 750rpx;
}

.gallery-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
  border-radius: 24rpx;
  padding: 4rpx 20rpx;
}

.d-name {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.d-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.d-price {
  font-size: 40rpx;
}

.d-price-unit {
  font-size: 22rpx;
  color: #8a857c;
  font-weight: 400;
  margin-left: 6rpx;
}

.d-sales {
  font-size: 24rpx;
  color: #8a857c;
}

.d-tags {
  margin-top: 16rpx;
}

.d-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.d-qty-label {
  margin-top: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  font-size: 25rpx;
  color: #5c544a;
  background: #f4efe7;
  border: 2rpx solid #eee6d8;
  border-radius: 8rpx;
  padding: 10rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip-active {
  color: #b9432f;
  border-color: #b9432f;
  background: rgba(185, 67, 47, 0.06);
  font-weight: 500;
}

.stepper {
  display: inline-flex;
  align-items: center;
  border: 2rpx solid #e5ddcf;
  border-radius: 8rpx;
  overflow: hidden;
}

.step-btn {
  width: 64rpx;
  height: 60rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 32rpx;
  color: #5c544a;
  background: #f4efe7;
}

.step-input {
  width: 96rpx;
  height: 60rpx;
  min-height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  background: #fff;
}

.d-min-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8a857c;
}

.spec-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f4efe7;
  font-size: 26rpx;
}

.spec-row:last-child {
  border-bottom: none;
}

.spec-key {
  width: 160rpx;
  color: #8a857c;
  flex-shrink: 0;
}

.spec-val {
  flex: 1;
  color: #33302b;
}

.d-desc {
  font-size: 26rpx;
  color: #5c544a;
  display: block;
}

.d-img {
  width: 100%;
  border-radius: 12rpx;
  margin-top: 20rpx;
  display: block;
}

/* 猜你喜欢 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48.6%;
  margin-bottom: 20rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(80, 60, 40, 0.08);
}

.ab-icon {
  flex: 0 1 110rpx;
  min-width: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: 1.3;
  font-size: inherit;
}

.ab-btn {
  border: none;
}

.ab-btn::after {
  border: none;
}

.ab-icon-emoji {
  font-size: 40rpx;
}

.ab-icon-text {
  font-size: 20rpx;
  color: #5c544a;
}

.ab-inquiry {
  flex: 1;
  margin-left: 16rpx;
  background: #b9432f;
  color: #fff;
  text-align: center;
  border-radius: 44rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 500;
}

.ab-cart,
.ab-buy {
  flex: 1 1 0;
  min-width: 0;
  margin-left: 12rpx;
  text-align: center;
  border-radius: 40rpx;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
}

.ab-cart {
  color: #b9432f;
  background: #fff;
  border: 2rpx solid #b9432f;
}

.ab-buy {
  color: #fff;
  background: #b9432f;
}

.wholesale-link {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8e5b3c;
}

/* 全屏大图查看器 */
.img-viewer {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.92);
}

.viewer-swiper {
  width: 100%;
  height: 100%;
}

.viewer-img {
  width: 100%;
  height: 100%;
}

.viewer-count {
  position: absolute;
  right: 24rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  color: #fff;
  font-size: 26rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 26rpx;
  padding: 6rpx 22rpx;
}
