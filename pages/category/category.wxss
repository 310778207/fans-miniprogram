page {
  height: 100%;
}

.cat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f4ef;
}

.search-bar {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 26rpx;
  font-size: 26rpx;
  color: #8a857c;
  box-shadow: 0 2rpx 10rpx rgba(80, 60, 40, 0.05);
}

.search-icon {
  margin-right: 12rpx;
  font-size: 24rpx;
}

.cat-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.side {
  width: 180rpx;
  height: 100%;
  background: #f1ece3;
}

.side-item {
  padding: 30rpx 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #5c544a;
  border-left: 6rpx solid transparent;
}

.side-item.active {
  background: #f7f4ef;
  color: #b9432f;
  font-weight: 600;
  border-left-color: #b9432f;
}

.main {
  flex: 1;
  height: 100%;
  padding: 20rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48%;
  margin-bottom: 18rpx;
}
