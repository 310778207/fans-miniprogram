<view class="page">
  <!-- 联系方式卡片 -->
  <view class="card contact-cards">
    <button class="cc-item cc-btn" open-type="contact" hover-class="hover">
      <text class="cc-icon">💬</text>
      <text class="cc-label">在线客服</text>
      <text class="cc-sub">微信内即时沟通</text>
    </button>
    <button class="cc-item cc-btn" bindtap="callPhone" hover-class="hover">
      <text class="cc-icon">📞</text>
      <text class="cc-label">电话咨询</text>
      <text class="cc-sub">{{config.phone}}</text>
    </button>
    <button class="cc-item cc-btn" bindtap="copyWechat" hover-class="hover">
      <text class="cc-icon">👥</text>
      <text class="cc-label">微信号</text>
      <text class="cc-sub">点击复制</text>
    </button>
    <button class="cc-item cc-btn" bindtap="copyEmail" hover-class="hover">
      <text class="cc-icon">✉️</text>
      <text class="cc-label">邮箱</text>
      <text class="cc-sub">点击复制</text>
    </button>
  </view>

  <!-- 询盘表单 -->
  <view class="card">
    <view class="form-title">提交询盘</view>
    <view class="form-sub">留下需求，我们会尽快与您联系（{{config.workTime}}）</view>

    <view class="picked" wx:if="{{form.productName}}">
      <text class="picked-tag">询价产品</text>
      <text class="picked-name">{{form.productName}}</text>
      <text class="picked-clear" bindtap="clearProduct">✕</text>
    </view>

    <view class="field">
      <text class="field-label">联系人 <text class="req">*</text></text>
      <input class="field-input" placeholder="怎么称呼您" value="{{form.name}}" bindinput="onField" data-field="name" />
    </view>
    <view class="field">
      <text class="field-label">手机号 <text class="req">*</text></text>
      <input class="field-input" type="number" maxlength="11" placeholder="方便我们回电" value="{{form.phone}}" bindinput="onField" data-field="phone" />
    </view>
    <view class="field">
      <text class="field-label">微信号</text>
      <input class="field-input" placeholder="选填" value="{{form.wechat}}" bindinput="onField" data-field="wechat" />
    </view>
    <view class="field">
      <text class="field-label">邮箱</text>
      <input class="field-input" placeholder="选填，可接收报价单" value="{{form.email}}" bindinput="onField" data-field="email" />
    </view>
    <view class="field field-area">
      <text class="field-label">需求描述 <text class="req">*</text></text>
      <textarea
        class="field-textarea"
        placeholder="请描述产品需求：品类、数量、尺寸、颜色、是否定制等"
        value="{{form.message}}"
        maxlength="500"
        bindinput="onField"
        data-field="message"
      />
      <text class="field-count">{{form.message.length}}/500</text>
    </view>

    <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="onSubmit">提交询盘</button>
    <view class="form-tip">提交后由厂家专人跟进，信息仅用于业务联系</view>
  </view>

  <!-- 地址 -->
  <view class="card addr-card">
    <text class="addr-icon">📍</text>
    <text class="addr-text">{{config.address}}</text>
  </view>
</view>
