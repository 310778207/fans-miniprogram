<view class="page">
  <!-- 用户头部：未登录点击整块登录；已登录支持微信头像/昵称填写 -->
  <view class="pf-head" hover-class="{{user ? 'none' : 'hover'}}" bindtap="onHeadTap">
    <!-- 未登录 -->
    <block wx:if="{{!user}}">
      <view class="pf-avatar">👤</view>
      <view class="pf-user">
        <view class="pf-name">点击登录</view>
        <view class="pf-slogan">登录后管理订单与收货信息</view>
      </view>
    </block>
    <!-- 已登录 -->
    <block wx:else>
      <button
        class="pf-avatar pf-avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        hover-class="hover"
      >
        <image wx:if="{{user.avatar}}" class="pf-avatar-img" src="{{user.avatar}}" mode="aspectFill" />
        <view wx:else class="pf-avatar-ph">👤</view>
      </button>
      <view class="pf-user">
        <input
          wx:if="{{editingName}}"
          class="pf-name-input"
          type="nickname"
          value="{{user.nickname}}"
          focus="{{editingName}}"
          placeholder="填写昵称"
          maxlength="20"
          placeholder-class="pf-name-input-ph"
          bindblur="onNameBlur"
          bindconfirm="onNameConfirm"
        />
        <view wx:else class="pf-name pf-name-tap" bindtap="startEditName">
          <text>{{user.nickname || '设置昵称'}}</text>
          <text class="pf-edit-ico">✏️</text>
        </view>
        <view class="pf-slogan">{{config.slogan}}</view>
      </view>
    </block>
  </view>

  <!-- 我的订单 -->
  <view class="card">
    <view class="pf-sec" bindtap="goOrders" data-status="">
      <text class="pf-sec-title">我的订单</text>
      <text class="pf-sec-more">全部订单 ›</text>
    </view>
    <view class="pf-odes">
      <view class="pf-ode" hover-class="hover" bindtap="goOrders" data-status="pending_payment">
        <text class="pf-ode-icon">💳</text>
        <text class="pf-ode-label">待付款</text>
        <text class="pf-ode-badge" wx:if="{{counts.pending}}">{{counts.pending}}</text>
      </view>
      <view class="pf-ode" hover-class="hover" bindtap="goOrders" data-status="paid">
        <text class="pf-ode-icon">📦</text>
        <text class="pf-ode-label">待发货</text>
        <text class="pf-ode-badge" wx:if="{{counts.paid}}">{{counts.paid}}</text>
      </view>
      <view class="pf-ode" hover-class="hover" bindtap="goOrders" data-status="shipped">
        <text class="pf-ode-icon">🚚</text>
        <text class="pf-ode-label">已发货</text>
        <text class="pf-ode-badge" wx:if="{{counts.shipped}}">{{counts.shipped}}</text>
      </view>
      <view class="pf-ode" hover-class="hover" bindtap="goOrders" data-status="completed">
        <text class="pf-ode-icon">✅</text>
        <text class="pf-ode-label">已完成</text>
      </view>
    </view>
  </view>

  <!-- 常用功能 -->
  <view class="card pf-menu">
    <view class="pf-row" hover-class="hover" bindtap="goAddress">
      <text class="pf-row-icon">📍</text>
      <text class="pf-row-label">收货地址管理</text>
      <text class="pf-row-arrow">›</text>
    </view>
    <view class="pf-row" hover-class="hover" bindtap="goAbout">
      <text class="pf-row-icon">🏷️</text>
      <text class="pf-row-label">品牌介绍</text>
      <text class="pf-row-arrow">›</text>
    </view>
    <button class="pf-row pf-btn" open-type="contact" hover-class="hover">
      <text class="pf-row-icon">💬</text>
      <text class="pf-row-label">在线客服</text>
      <text class="pf-row-arrow">›</text>
    </button>
    <view class="pf-row" hover-class="hover" bindtap="callPhone">
      <text class="pf-row-icon">📞</text>
      <text class="pf-row-label">电话咨询</text>
      <text class="pf-row-val">{{config.phone}}</text>
      <text class="pf-row-arrow">›</text>
    </view>
    <view class="pf-row" hover-class="hover" bindtap="goAdmin">
      <text class="pf-row-icon">🔐</text>
      <text class="pf-row-label">商家入口 · 询盘管理</text>
      <text class="pf-row-arrow">›</text>
    </view>
    <view wx:if="{{user}}" class="pf-row pf-logout" hover-class="hover" bindtap="logout">
      <text class="pf-row-icon">🚪</text>
      <text class="pf-row-label">退出登录</text>
      <text class="pf-row-arrow">›</text>
    </view>
  </view>
</view>
