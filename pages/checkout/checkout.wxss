page {
  background: #f7f4ef;
}

.ck-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.addr-card {
  position: relative;
  padding-right: 70rpx;
}

.ck-addr-top {
  display: flex;
  align-items: center;
}

.ck-addr-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.ck-addr-phone {
  font-size: 26rpx;
  color: #6b655b;
}

.ck-addr-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5c544a;
}

.ck-addr-empty {
  font-size: 28rpx;
  color: #b9432f;
}

.ck-addr-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 44rpx;
  color: #c9c2b6;
}

.ck-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4efe7;
}

.ck-item:last-of-type {
  border-bottom: none;
}

.ck-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f3ead9;
  flex-shrink: 0;
}

.ck-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.ck-name {
  font-size: 26rpx;
  color: #33302b;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ck-sku {
  display: inline-block;
  font-size: 20rpx;
  color: #8e5b3c;
  background: rgba(201, 160, 99, 0.14);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-top: 8rpx;
}

.ck-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.ck-qty {
  font-size: 24rpx;
  color: #8a857c;
}

.ck-remark {
  border-top: 1rpx solid #f4efe7;
  margin-top: 8rpx;
}

.field-label {
  width: 170rpx;
  font-size: 26rpx;
  color: #5c544a;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  font-size: 26rpx;
}

.ck-amount-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #5c544a;
  padding: 10rpx 0;
}

.ck-amount-total {
  border-top: 1rpx solid #f4efe7;
  margin-top: 10rpx;
  padding-top: 20rpx;
  color: #33302b;
}

.ck-pay-tip {
  font-size: 22rpx;
  color: #b8b2a8;
  text-align: center;
  margin-bottom: 20rpx;
}

.ck-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(80, 60, 40, 0.08);
}

.ck-bar-total {
  font-size: 26rpx;
  color: #5c544a;
}

.ck-bar-price {
  font-size: 36rpx;
}

.ck-submit {
  margin: 0;
  padding: 0 60rpx;
}
