/* 全局样式 */
page {
  background: #f7f4ef;
  color: #33302b;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

view,
text,
image {
  box-sizing: border-box;
}

/* 页面通用容器 */
.page {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(80, 60, 40, 0.05);
}

/* 区块标题 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}

.section-head .title {
  font-size: 34rpx;
  font-weight: 600;
  color: #33302b;
}

.section-head .title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #b9432f;
  margin-right: 14rpx;
  vertical-align: -2rpx;
}

.section-head .more {
  font-size: 24rpx;
  color: #8a857c;
}

/* 价格 */
.price {
  color: #b9432f;
  font-weight: 600;
}

.price .rmb {
  font-size: 22rpx;
  margin-right: 2rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #b9432f;
  background: rgba(185, 67, 47, 0.08);
  border: 1rpx solid rgba(185, 67, 47, 0.35);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}

.tag.gold {
  color: #8e5b3c;
  background: rgba(201, 160, 99, 0.14);
  border-color: rgba(201, 160, 99, 0.5);
}

/* 主按钮 */
.btn-primary {
  background: #b9432f;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  background: #fff;
  color: #b9432f;
  border: 2rpx solid #b9432f;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-plain::after {
  border: none;
}

/* 按钮按下效果 */
.hover {
  opacity: 0.75;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #8a857c;
  font-size: 26rpx;
  padding: 120rpx 0;
}
